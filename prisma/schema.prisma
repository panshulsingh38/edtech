generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Test {
  id         String     @id @default(uuid())
  title      String
  sourceText String?
  userId     String?
  createdAt  DateTime   @default(now())
  questions  Question[]
  lobbies    Lobby[]
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Question {
  id            String   @id @default(uuid())
  testId        String
  type          String
  questionText  String
  options       String?  // SQLite doesn't support JSON, so we use String to store serialized JSON
  correctAnswer String
  explanation   String

  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  reviews       FlashcardReview[]
}

model FlashcardReview {
  id          String   @id @default(uuid())
  questionId  String
  status      String   // "Hard", "Good", "Easy"
  nextReview  DateTime
  createdAt   DateTime @default(now())

  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Lobby {
  id        String   @id @default(uuid())
  testId    String
  status    String   // "waiting", "playing", "finished"
  createdAt DateTime @default(now())

  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  players   LobbyPlayer[]
}

model LobbyPlayer {
  id        String   @id @default(uuid())
  lobbyId   String
  name      String
  score     Int      @default(0)
  progress  Int      @default(0) // Percentage or questions completed
  joinedAt  DateTime @default(now())
  
  lobby     Lobby    @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
}

// NextAuth Models

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("USER") // "USER" or "ADMIN"
  insights      Int       @default(10)
  accounts      Account[]
  sessions      Session[]
  tests         Test[]
  solutionLogs  SolutionLog[]
}

model SolutionLog {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "SNAP_AND_SOLVE" or "SURVIVAL_GUIDE"
  content   String   // The markdown response
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
