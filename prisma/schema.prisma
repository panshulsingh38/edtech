generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Test {
  id         String     @id @default(uuid())
  title      String
  sourceText String?
  userId     String?
  tenantId   String?
  createdAt  DateTime   @default(now())
  questions  Question[]
  lobbies    Lobby[]
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
}

model Question {
  id            String   @id @default(uuid())
  testId        String
  type          String
  questionText  String
  options       String?  // SQLite doesn't support JSON, so we use String to store serialized JSON
  correctAnswer String
  explanation   String
  steps         String?  // JSON string for multi-step breakdown
  flawIndex     Int?     // For 'Spot the Flaw' questions
  variables     String?  // JSON string for slider_interactive variables
  targetCoordinate String? // JSON string for coordinate_hotspot
  topicId       String?
  imagePrompt   String?  // AI generated image prompt for the question

  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  topic         Topic?   @relation(fields: [topicId], references: [id])
  reviews       FlashcardReview[]
  spacedReviews SpacedRepetition[]
  questionResults QuestionResult[]
}

model FlashcardReview {
  id          String   @id @default(uuid())
  questionId  String
  status      String   // "Hard", "Good", "Easy"
  nextReview  DateTime
  createdAt   DateTime @default(now())

  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model SpacedRepetition {
  id          String   @id @default(uuid())
  userId      String
  questionId  String
  interval    Int      @default(0)
  easeFactor  Float    @default(2.5)
  repetitions Int      @default(0)
  nextReview  DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionResult {
  id              String   @id @default(uuid())
  userId          String
  questionId      String
  isCorrect       Boolean
  confidenceScore Float    // 1.0 (Certain), 0.5 (Unsure), 0.0 (Guess)
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Lobby {
  id        String   @id @default(uuid())
  testId    String
  status    String   // "waiting", "playing", "finished"
  createdAt DateTime @default(now())

  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  players   LobbyPlayer[]
}

model LobbyPlayer {
  id        String   @id @default(uuid())
  lobbyId   String
  name      String
  score     Int      @default(0)
  progress  Int      @default(0) // Percentage or questions completed
  joinedAt  DateTime @default(now())
  
  lobby     Lobby    @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
}

model Syllabus {
  id        String   @id @default(uuid())
  name      String
  topics    Topic[]
}

model Topic {
  id          String   @id @default(uuid())
  syllabusId  String
  name        String
  parentId    String?
  parent      Topic?   @relation("TopicHierarchy", fields: [parentId], references: [id])
  children    Topic[]  @relation("TopicHierarchy")
  
  syllabus    Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  questions   Question[]
}

// NextAuth Models

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("USER") // "USER" or "ADMIN"
  insights      Int       @default(10)
  streak        Int       @default(0)
  lastActive    DateTime  @default(now())
  examDate      DateTime?
  tenantId      String?
  accounts      Account[]
  sessions      Session[]
  tests         Test[]
  solutionLogs  SolutionLog[]
  payments      Payment[]
  spacedReviews SpacedRepetition[]
  questionResults QuestionResult[]
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  subdomain   String   @unique // e.g. 'school1', 'district'
  logoUrl     String?
  themeColor  String?  @default("#4f46e5") // default indigo
  createdAt   DateTime @default(now())
  
  users       User[]
  tests       Test[]
}

model SolutionLog {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "SNAP_AND_SOLVE" or "SURVIVAL_GUIDE"
  content   String   // The markdown response
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Payment {
  id                String   @id @default(cuid())
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  userId            String
  packId            String?
  insightsAdded     Int
  status            String   @default("SUCCESS")
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
